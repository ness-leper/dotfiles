# A basic wofi configuration file

# Choose the modes to display. 'drun' shows desktop entries (applications with .desktop files),
# 'run' shows executables in your PATH. You can list multiple modes separated by commas.
mode=drun,run

# Set the width of the wofi window. Can be in pixels (e.g., 500) or a percentage of the screen (e.g., 30%).
width=30%

# Set the height of the wofi window. Can be in pixels (e.g., 300) or a percentage of the screen (e.g., 40%).
height=100%

# Set the location of the wofi window on the screen.
# Options include: center, top_left, top, top_right, right, bottom_right, bottom, bottom_left, left.
location=left

# Set the horizontal and vertical offset from the chosen location.
# xoffset=0
# yoffset=0

# Set the prompt text displayed in the search bar. Defaults to the mode name.
prompt=Search:

# Hide the scrollbar. Set to true to hide.
hide_scroll=false

# Enable or disable case sensitivity in search. Set to true for case-insensitive search.
insensitive=true

# Specify the matching mode.
# Options include: contains, fuzzy, regex.
matching=fuzzy

# Allow rendering of images (like application icons) specified via pango markup or xresources.
allow_images=true

# Specify the terminal emulator to use when launching applications that require a terminal.
# Wofi has a default order (kitty, termite, gnome-terminal, weston-terminal),
# but you can override it here.
# term=your_terminal_emulator_command

# If true, pressing Enter on a search query without selecting an entry will execute the search itself
# (useful in dmenu mode), otherwise it launches the first result.
# exec_search=false

# --- Styling ---
# Wofi's styling is primarily done via a CSS file.
# The default location for the CSS file is typically $XDG_CONFIG_HOME/wofi/style.css
# You can specify a custom CSS file here:
#style=~/.config/wofi/style.css

# --- Colors ---
# Wofi can also use a colors file, often generated by tools like pywal.
# The default location is often $XDG_CACHE_HOME/wal/colors.
# You can specify a custom colors file here:
# colors=/path/to/your/custom/colors

# --- Mode-specific options ---
# Options specific to a mode are prefixed with the mode name followed by a hyphen.
# Example for drun mode:
# drun-display_generic=true # Display generic application names if available
# drun-print_command=false # If true, print the command instead of executing it

# Example for dmenu mode:
# dmenu-parse_action=false # If true, strip image sequences and pango markup from the output
# dmenu-separator=\n # The character used to separate dmenu entries
